# ---------------------------------------------------------------------------
# Moriko Studio — local server configuration
# Copy this file to `.env` and fill in only what you need. The server never
# sends provider keys to the browser.
# ---------------------------------------------------------------------------

# Port for the API proxy (Vite dev server proxies /api -> here).
PORT=8791

# Comma-separated origins allowed to talk to the proxy. Empty = allow all.
CORS_ORIGIN=http://localhost:5178,http://127.0.0.1:5588

# Where ALL app data lives (providers, key vault, chats, images, agent state).
# Leave empty for the default (~/.moriko-studio). Also settable from
# Settings -> Data inside the app; the pick is persisted into .env.
MORIKO_HOME=

# *Legacy:* only names the old .data/ folder the first-boot migration reads.
# Leave empty unless migrating from a pre-restructure install.
DATA_DIR=

# *Vite-side:* where the dev proxy forwards /api requests.
PROXY_TARGET=http://127.0.0.1:8826


# --- Metadata sync (optional) ------------------------------------------------
# MORIKO_NO_SYNC=1              skip the automatic snapshot freshness check
# MORIKO_SYNC_MAX_AGE_HOURS=24  refresh snapshots older than N hours
