{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "rsprd.v1.schema.json",
  "title": "RS-PRD v1",
  "type": "object",
  "required": ["format", "version", "prd", "achievements"],
  "properties": {
    "format": { "const": "rs-prd" },
    "version": { "type": "number", "maximum": 1 },
    "rev": { "type": "number" },
    "prd": {
      "type": "object",
      "required": ["id", "title", "status", "createdBy"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "status": { "enum": ["draft", "running", "paused", "done", "archived"] },
        "createdAt": { "type": "string" },
        "createdBy": { "$ref": "#/definitions/actor" },
        "language": { "enum": ["en", "id"] },
        "goals": { "type": "array", "items": { "type": "string" } },
        "nonGoals": { "type": "array", "items": { "type": "string" } },
        "constraints": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "text": { "type": "string" },
              "enforce": { "enum": ["advisory", "strict"] }
            }
          }
        },
        "globalScope": { "$ref": "#/definitions/scope" },
        "architecture": { "type": "string", "description": "High-level system architecture description" },
        "modules": {
          "type": "array",
          "maxItems": 60,
          "items": { "$ref": "#/definitions/module" },
          "description": "Architecture modules with layer boundaries, allowedImports, and file scopes"
        },
        "milestones": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "object",
            "required": ["id", "title"],
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "goal": { "type": "string" }
            }
          }
        },
        "nonFunctional": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "text": { "type": "string" },
              "metric": { "type": "string" }
            }
          }
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "text": { "type": "string" },
              "mitigation": { "type": "string" },
              "severity": { "enum": ["low", "medium", "high"] }
            }
          }
        },
        "technicalDecisions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": { "type": "string" },
              "reason": { "type": "string" },
              "at": { "type": "string" }
            },
            "required": ["text"]
          },
          "description": "Key technical decisions with rationale"
        }
      }
    },
    "achievements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "state"],
        "properties": {
          "id": { "type": "string" },
          "no": { "type": "number" },
          "title": { "type": "string" },
          "kind": { "enum": ["feature", "bugfix", "refactor", "chore", "research", "test"] },
          "tier": { "enum": ["bronze", "silver", "gold", "diamond"] },
          "points": { "type": "number" },
          "description": { "type": "string" },
          "technical": { "type": "string" },
          "acceptance": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["text"],
              "properties": {
                "id": { "type": "string" },
                "text": { "type": "string" },
                "done": { "type": "boolean" }
              }
            }
          },
          "scope": { "$ref": "#/definitions/scope" },
          "dependsOn": { "type": "array", "items": { "type": "string" } },
          "moduleId": { "type": "string", "description": "Architecture module id (from prd.modules) this achievement belongs to" },
          "milestoneId": { "type": "string", "description": "Milestone id (from prd.milestones) this achievement delivers" },
          "contracts": { "$ref": "#/definitions/contracts" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "state": { "enum": ["locked", "available", "claimed", "in_progress", "review", "done", "blocked", "dropped"] },
          "claim": {
            "type": "object",
            "properties": {
              "by": { "$ref": "#/definitions/actor" },
              "at": { "type": "string" },
              "heartbeat": { "type": "string" },
              "ttlSec": { "type": "number" },
              "label": { "type": "string" }
            }
          },
          "comments": { "type": "array" },
          "scopeChanges": {
            "type": "array",
            "items": { "$ref": "#/definitions/scopeChange" }
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": { "type": "string" },
                "op": { "enum": ["add", "modify", "delete", "rename", "copy", "refactor"] },
                "summary": { "type": "string" },
                "from": { "type": "string" },
                "by": { "$ref": "#/definitions/actor" },
                "at": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "history": { "type": "array" }
  },
  "definitions": {
    "actor": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["user", "agent", "operator", "system"] },
        "name": { "type": "string" },
        "sessionId": { "type": "string" },
        "model": { "type": "string" },
        "label": { "type": "string" }
      }
    },
    "scope": {
      "type": "object",
      "description": "File glob boundaries (include minus exclude) and write guard rules",
      "properties": {
        "include": { "type": "array", "items": { "type": "string" } },
        "exclude": { "type": "array", "items": { "type": "string" } },
        "maxFiles": { "type": "number" },
        "allowCreate": { "type": "boolean" },
        "allowDelete": { "type": "boolean" }
      }
    },
    "module": {
      "type": "object",
      "required": ["id", "name"],
      "description": "Architectural module with layer classification, allowed module imports, and file scope",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "desc": { "type": "string" },
        "layer": {
          "type": "string",
          "enum": ["presentation", "application", "domain", "infrastructure", "shared", "ui", "state", "infra"]
        },
        "allowedImports": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Module ids that files inside this module are allowed to import from"
        },
        "scope": { "$ref": "#/definitions/scope" }
      }
    },
    "contracts": {
      "type": "object",
      "required": ["provides", "consumes"],
      "additionalProperties": false,
      "description": "Explicit symbol contracts declared on an achievement and cross-validated 1:1 against real AST exports/imports in Interlinked",
      "properties": {
        "provides": {
          "type": "array",
          "maxItems": 30,
          "items": { "type": "string" },
          "description": "Public symbols (functions, constants, hooks, types, default export) promised by this achievement within its scope"
        },
        "consumes": {
          "type": "array",
          "maxItems": 30,
          "items": { "type": "string" },
          "description": "Upstream symbols this achievement expects to import from other modules/achievements"
        }
      }
    },
    "scopeChange": {
      "type": "object",
      "required": ["op", "paths", "reason", "by", "at"],
      "properties": {
        "at": { "type": "string" },
        "by": { "$ref": "#/definitions/actor" },
        "op": { "enum": ["widen", "narrow"] },
        "paths": { "type": "array", "items": { "type": "string" } },
        "reason": { "type": "string" },
        "approved": { "type": "boolean" },
        "approvedBy": { "$ref": "#/definitions/actor" },
        "approvedAt": { "type": "string" }
      }
    }
  }
}
