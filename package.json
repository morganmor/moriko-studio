{
  "name": "moriko-studio",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "description": "Moriko Studio — AI chat workspace with system instructions, MCP tools, multi-provider support, and a local proxy.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node scripts/dev-server.mjs",
    "dev:server:watch": "tsx watch server/index.ts",
    "dev:web": "node scripts/dev-web.mjs",
    "build": "tsc -b tsconfig.app.json tsconfig.node.json && vite build",
    "preview": "vite preview",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "sync:models": "node scripts/sync-model-metadata.mjs",
    "sync:diffusion": "node scripts/sync-diffusion-metadata.mjs",
    "sync": "node scripts/sync-model-metadata.mjs && node scripts/sync-diffusion-metadata.mjs",
    "sync:if-stale": "node scripts/sync-if-stale.mjs",
    "typecheck": "tsc -b tsconfig.app.json tsconfig.node.json"
  },
  "dependencies": {
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "katex": "^0.16.21",
    "lucide-react": "^0.469.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "ws": "^8.21.3",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "matter-js": "^0.20.0",
    "pixi.js": "^8.22.0",
    "playwright-core": "1.49.1",
    "postcss": "^8.4.49",
    "three": "^0.186.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
